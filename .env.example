PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus_coin_db
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CampusCoinAdmin123

# Gmail SMTP / Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=yourgmail@gmail.com
PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
# Only enable this for explicit local development testing. Keep false in production.
ALLOW_RESET_CODE_IN_RESPONSE=false
